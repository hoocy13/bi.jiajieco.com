    "sources": [
      {
        "id": "sales_monthly",
        "label": "销售月度汇总",
        "query": {
          "engine": "mysql",
          "description": "同一已发布数据版本下，对三个完整自然月的销售额、订单数和销售数量求和。",
          "sql": "SELECT period, SUM(paid_amount), SUM(orders), SUM(quantity) FROM ads.ads_sales_daily WHERE data_version = :data_version AND sales_date IN REQUESTED_PERIODS GROUP BY period",
          "tables_used": [
            "ads.ads_sales_daily"
          ],
          "executed_at": "",
          "filters": [
            "data_version=SALES_DATA_VERSION",
            "YEAR_AGO_START至YEAR_AGO_END",
            "PREVIOUS_START至PREVIOUS_END",
            "REPORT_START至REPORT_END"
          ],
          "metric_definitions": {
            "销售额": "按销售日期汇总订单实付金额。",
            "订单数": "按日汇总表中的orders字段求和。",
            "销售数量": "按日汇总表中的quantity字段求和。",
            "平均订单金额": "销售额除以订单数。",
            "环比": "本月相对上月的变化率。",
            "同比": "本月相对去年同期的变化率。"
          }
        }
      },
      {
        "id": "sales_daily",
        "label": "销售日汇总",
        "query": {
          "engine": "mysql",
          "description": "读取报告月每日销售额、订单数和销售数量。",
          "sql": "SELECT sales_date, paid_amount, orders, quantity FROM ads.ads_sales_daily WHERE data_version = :data_version AND sales_date BETWEEN :start_date AND :end_date ORDER BY sales_date",
          "tables_used": [
            "ads.ads_sales_daily"
          ],
          "executed_at": "",
          "filters": [
            "data_version=SALES_DATA_VERSION",
            "REPORT_START至REPORT_END"
          ]
        }
      },
      {
        "id": "sales_brand",
        "label": "品牌销售汇总",
        "query": {
          "engine": "mysql",
          "description": "读取报告月已归因品牌销售额，并按金额排序。",
          "sql": "SELECT brand, SUM(paid_amount), SUM(orders), SUM(quantity) FROM ads.ads_sales_daily_brand_scope WHERE data_version = :data_version AND product_type_scope = 'all' AND sales_date BETWEEN :start_date AND :end_date GROUP BY brand ORDER BY SUM(paid_amount) DESC",
          "tables_used": [
            "ads.ads_sales_daily_brand_scope"
          ],
          "executed_at": "",
          "filters": [
            "data_version=SALES_DATA_VERSION",
            "product_type_scope=all",
            "REPORT_START至REPORT_END"
          ]
        }
      },
      {
        "id": "sales_channel",
        "label": "销售渠道归类汇总",
        "query": {
          "engine": "mysql",
          "description": "销售渠道事实按当前渠道配置归并为线上和线下；未匹配渠道使用既有兜底规则。",
          "sql": "SELECT sales_date, channel, SUM(paid_amount), SUM(orders), SUM(quantity) FROM ads.ads_sales_daily_channel WHERE data_version = :data_version AND sales_date IN REQUESTED_PERIODS GROUP BY sales_date, channel",
          "tables_used": [
            "ads.ads_sales_daily_channel",
            "ods.渠道列表"
          ],
          "executed_at": "",
          "filters": [
            "data_version=SALES_DATA_VERSION",
            "三个完整自然月"
          ]
        }
      },
      {
        "id": "sales_product_type",
        "label": "销售货品分类汇总",
        "query": {
          "engine": "mysql",
          "description": "按已发布销售明细中的正装和小样分类汇总金额与数量。",
          "sql": "SELECT product_type_scope, SUM(paid_amount), SUM(orders), SUM(quantity) FROM ads.ads_sales_detail_daily_scope WHERE data_version = :data_version AND sales_date IN REQUESTED_PERIODS AND product_type_scope IN ('full_size','sample') GROUP BY product_type_scope",
          "tables_used": [
            "ads.ads_sales_detail_daily_scope"
          ],
          "executed_at": "",
          "filters": [
            "data_version=SALES_DATA_VERSION",
            "三个完整自然月"
          ]
        }
      },
      {
        "id": "sales_customer",
        "label": "可识别客户汇总",
        "query": {
          "engine": "mysql",
          "description": "按客户标识汇总月内订单数，统计可识别客户与月内复购客户。",
          "sql": "SELECT customer_code, SUM(orders), SUM(paid_amount), SUM(quantity) FROM ads.ads_sales_customer_daily WHERE data_version = :data_version AND brand = '__all__' AND sales_date IN REQUESTED_PERIODS GROUP BY customer_code",
          "tables_used": [
            "ads.ads_sales_customer_daily",
            "ads.ads_sales_customer_quality_daily"
          ],
          "executed_at": "",
          "filters": [
            "data_version=SALES_DATA_VERSION",
            "brand=__all__",
            "三个完整自然月"
          ]
        }
      },
      {
        "id": "inventory_arrival",
        "label": "月度到货汇总",
        "query": {
          "engine": "mysql",
          "description": "按实际入库日期汇总净到货数量、入库单和品牌数；成本字段因业务口径尚未核准而不展示。",
          "sql": "SELECT SUM(quantity), COUNT(DISTINCT doc_id), COUNT(DISTINCT brand) FROM ads.ads_inventory_arrival_item WHERE data_version = :data_version AND receipt_date IN REQUESTED_PERIODS",
          "tables_used": [
            "ads.ads_inventory_arrival_item"
          ],
          "executed_at": "",
          "filters": [
            "data_version=INVENTORY_DATA_VERSION",
            "三个完整自然月"
          ]
        }
      },
      {
        "id": "inventory_snapshot",
        "label": "历史月末库存快照",
        "query": {
          "engine": "mysql",
          "description": "读取指定月末且批次状态为SUCCESS的历史库存数量。",
          "sql": "SELECT h.快照日期, COUNT(h.货品编号), SUM(h.库存量) FROM ods.历史库存 h JOIN ods.历史库存快照批次 b ON b.快照日期 = h.快照日期 WHERE UPPER(b.状态) = 'SUCCESS' AND h.快照日期 IN REQUESTED_MONTH_ENDS GROUP BY h.快照日期",
          "tables_used": [
            "ods.历史库存",
            "ods.历史库存快照批次"
          ],
          "executed_at": "",
          "filters": [
            "2025-08-31",
            "2026-07-31",
            "2026-08-31",
            "状态=SUCCESS"
          ]
        }
      }
    ],
